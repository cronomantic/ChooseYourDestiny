[[
/* ==========================================================================
   sprites.cyd  -  Sprites con mascara para CYD
   --------------------------------------------------------------------------
   Pinta trozos de la imagen cargada en el buffer (PICTURE) sobre la pantalla
   sin borrar el fondo: cada sprite lleva su mascara, la silueta de lo que tapa.
   El nucleo es ensamblador Z80 nativo (bloque ASM 'sprcore'); las rutinas
   publicas son GOSUB-ables. Si no las llamas, el compilador no incluye nada.

   USO: incluye este fichero al PRINCIPIO de tu programa (se auto-salta sus
   rutinas con un GOTO interno) y dibuja en la misma imagen el sprite y, al
   lado, su mascara: en tinta los pixeles que el sprite tapa. Por ejemplo:

     PICTURE 1 : DISPLAY 1      <- el fondo, en pantalla
     PICTURE 2                  <- la hoja de sprites, al buffer (no se ve)
     SET sprX TO 0 : SET sprY TO 0 : SET sprW TO 2 : SET sprH TO 3
     SET sprMX TO 2 : SET sprMY TO 0
     SET sprDX TO 14 : SET sprDY TO 10
     GOSUB sprDraw

   Todo se mide en caracteres (8x8), como en BLIT. Lo que sale de la pantalla
   por la derecha o por abajo se recorta.

   PARAMETROS. Reserva las variables 200..209:
     sprX, sprY   (200, 201)  esquina del sprite en el buffer
     sprW, sprH   (202, 203)  ancho y alto
     sprMX, sprMY (204, 205)  esquina de su mascara en el buffer
     sprDX, sprDY (206, 207)  posicion en pantalla
     sprAttr      (208)       0: los colores de la pantalla no cambian
                              1: el sprite pone sus colores en las celdas
                                 donde su mascara no esta vacia
     sprErr       (209)       1 si sprSave no ha podido guardar (demasiado grande)

   API:
     sprDraw    : pantalla = (pantalla AND NOT mascara) OR sprite
     sprXor     : pantalla = pantalla XOR sprite (sin mascara; repetirlo lo borra)
     sprSave    : guarda lo que hay en pantalla en el rectangulo sprDX, sprDY,
                  sprW, sprH (hasta 32 caracteres; si no cabe, sprErr = 1)
     sprRestore : vuelve a poner lo guardado, donde estaba

   Para mover un sprite: sprSave, sprDraw, y antes del siguiente paso sprRestore.
   ========================================================================== */

DECLARE 200 AS sprX : DECLARE 201 AS sprY : DECLARE 202 AS sprW
DECLARE 203 AS sprH : DECLARE 204 AS sprMX : DECLARE 205 AS sprMY
DECLARE 206 AS sprDX : DECLARE 207 AS sprDY : DECLARE 208 AS sprAttr
DECLARE 209 AS sprErr

GOTO sprSkip

LABEL sprDraw    : CALL nat_sprdraw    : RETURN
LABEL sprXor     : CALL nat_sprxor     : RETURN
LABEL sprSave    : CALL nat_sprsave    : RETURN
LABEL sprRestore : CALL nat_sprrestore : RETURN

/* --- Nucleo nativo (Z80). Lee los parametros en FLAGS+200..; el buffer de la
       imagen (SCREEN_BUFFER_PXL) guarda cada fila de caracteres en una pagina
       de 256 bytes: fila*256 + linea*32 + columna. --- */
ASM sprcore EXPORTS nat_sprdraw, nat_sprxor, nat_sprsave, nat_sprrestore

SPR_P           EQU FLAGS+200   ; sprX
SPR_STORE_CHARS EQU 32          ; capacidad de sprSave (9 bytes por caracter)

nat_sprdraw:
    call spr_clip
    ret z
    ld hl, (SPR_P+4)            ; L = MX, H = MY
    ld de, (SPR_P+0)            ; E = SX, D = SY
    or a
    sbc hl, de
    ld (spr_delta), hl          ; mascara - sprite, dentro del buffer
    call spr_start              ; HL = buffer, DE = pantalla, B = filas
.row:
    push bc
    push hl
    push de
    ld c, 8
.line:
    push bc
    push de
    push hl
    ld bc, (spr_delta)
    add hl, bc
    push hl
    pop ix                      ; IX -> mascara
    pop hl
    push hl                     ; HL -> sprite
    ld a, (spr_cols)
    ld b, a
.byte:
    ld a, (ix+0)
    cpl
    ex de, hl
    and (hl)                    ; pantalla AND NOT mascara
    ex de, hl
    or (hl)                     ; OR sprite
    ld (de), a
    inc hl
    inc de
    inc ix
    djnz .byte
    pop hl
    pop de
    pop bc
    ld a, l
    add a, 32                   ; siguiente linea del buffer
    ld l, a
    inc d                       ; siguiente linea de la pantalla
    dec c
    jr nz, .line
    pop de
    pop hl
    pop bc
    call spr_next_row
    djnz .row
    jp spr_attrs

nat_sprxor:
    call spr_clip
    ret z
    call spr_start
.row:
    push bc
    push hl
    push de
    ld c, 8
.line:
    push hl
    push de
    ld a, (spr_cols)
    ld b, a
.byte:
    ld a, (de)
    xor (hl)
    ld (de), a
    inc hl
    inc de
    djnz .byte
    pop de
    pop hl
    ld a, l
    add a, 32
    ld l, a
    inc d
    dec c
    jr nz, .line
    pop de
    pop hl
    pop bc
    call spr_next_row
    djnz .row
    ret

nat_sprsave:
    xor a
    ld (spr_saved_rows), a      ; nada guardado
    ld (SPR_P+9), a             ; sprErr = 0
    call spr_clip
    ret z
    ld a, (spr_cols)
    ld e, a
    ld d, 0
    ld a, (spr_rows)
    ld b, a
    ld hl, 0
.mul:
    add hl, de
    djnz .mul                   ; HL = caracteres a guardar
    ld de, SPR_STORE_CHARS+1
    or a
    sbc hl, de
    jr c, .fits
    ld a, 1
    ld (SPR_P+9), a             ; sprErr = 1: no cabe
    ret
.fits:
    ld hl, (SPR_P+6)            ; L = DX, H = DY
    ld (spr_saved_x), hl
    ld a, (spr_cols)
    ld (spr_saved_cols), a
    ld a, (spr_rows)
    ld (spr_saved_rows), a
    xor a                       ; pantalla -> almacen
    jr spr_copy

nat_sprrestore:
    ld a, (spr_saved_rows)
    or a
    ret z
    ld (spr_rows), a
    ld a, (spr_saved_cols)
    ld (spr_cols), a
    ld a, 1                     ; almacen -> pantalla

; Copia entre la pantalla en spr_saved_x/y (spr_cols x spr_rows) y spr_store,
; en el sentido de A (0: pantalla -> almacen).
spr_copy:
    ld (spr_dir), a
    ld de, (spr_saved_x)        ; E = x, D = y
    call spr_scr
    ex de, hl                   ; HL = pantalla
    ld de, spr_store
    ld a, (spr_rows)
    ld b, a
.row:
    push bc
    push hl
    ld c, 8
.line:
    push bc
    push hl
    call .move
    pop hl
    pop bc
    inc h
    dec c
    jr nz, .line
    pop hl
    ld a, l
    add a, 32                   ; siguiente fila de la pantalla
    ld l, a
    jr nc, 1f
    ld a, h
    add a, 8
    ld h, a
1:  pop bc
    djnz .row
    push de
    ld de, (spr_saved_x)
    call spr_att_off
    ld bc, $5800
    add hl, bc                  ; HL = atributos en pantalla
    pop de
    ld a, (spr_rows)
    ld b, a
.arow:
    push bc
    push hl
    call .move
    pop hl
    ld bc, 32
    add hl, bc
    pop bc
    djnz .arow
    ret
; spr_cols bytes entre HL (pantalla) y DE (almacen); DE avanza.
.move:
    ld a, (spr_cols)
    ld c, a
    ld b, 0
    ld a, (spr_dir)
    or a
    jr nz, .to_screen
    ldir
    ret
.to_screen:
    ex de, hl
    ldir
    ex de, hl
    ret

; Recorta el rectangulo a la pantalla: spr_cols, spr_rows. Z si no queda nada.
spr_clip:
    ld a, (SPR_P+6)             ; DX
    cp 32
    jr nc, .none
    ld c, a
    ld a, 32
    sub c
    ld c, a                     ; columnas hasta el borde derecho
    ld a, (SPR_P+2)             ; W
    cp c
    jr c, 1f
    ld a, c
1:  ld (spr_cols), a
    or a
    ret z
    ld a, (SPR_P+7)             ; DY
    cp 24
    jr nc, .none
    ld c, a
    ld a, 24
    sub c
    ld c, a
    ld a, (SPR_P+3)             ; H
    cp c
    jr c, 2f
    ld a, c
2:  ld (spr_rows), a
    or a
    ret
.none:
    xor a
    ret

; HL = buffer en (SX, SY), DE = pantalla en (DX, DY), B = filas.
spr_start:
    ld a, (SPR_P+1)             ; SY
    add a, HIGH SCREEN_BUFFER_PXL
    ld h, a
    ld a, (SPR_P+0)             ; SX
    ld l, a
    ld de, (SPR_P+6)            ; E = DX, D = DY
    call spr_scr
    ld a, (spr_rows)
    ld b, a
    ret

; Columna E, fila D -> DE = direccion en pantalla (linea 0 del caracter).
spr_scr:
    ld a, d
    and 7
    rrca
    rrca
    rrca
    or e
    ld e, a
    ld a, d
    and $18
    or $40
    ld d, a
    ret

; HL (buffer) y DE (pantalla) a la siguiente fila de caracteres.
spr_next_row:
    inc h
    ld a, e
    add a, 32
    ld e, a
    ret nc
    ld a, d
    add a, 8
    ld d, a
    ret

; Fila D, columna E -> HL = fila * 32 + columna.
spr_att_off:
    ld l, d
    ld h, 0
    add hl, hl
    add hl, hl
    add hl, hl
    add hl, hl
    add hl, hl
    ld a, l
    or e
    ld l, a
    ret

; sprAttr = 1: copia los atributos del sprite en las celdas cuya mascara no
; esta vacia.
spr_attrs:
    ld a, (SPR_P+8)
    or a
    ret z
    ld de, (SPR_P+0)            ; E = SX, D = SY
    call spr_att_off
    ld bc, SCREEN_BUFFER_ATT
    add hl, bc
    ld (spr_asrc), hl
    ld de, (SPR_P+6)            ; E = DX, D = DY
    call spr_att_off
    ld bc, $5800
    add hl, bc
    ld (spr_adst), hl
    ld hl, (SPR_P+4)            ; L = MX, H = MY
    ld a, h
    add a, HIGH SCREEN_BUFFER_PXL
    ld h, a
    ld (spr_amask), hl
    ld a, (spr_rows)
    ld b, a
.row:
    push bc
    ld hl, (spr_amask)
    ld de, (spr_adst)
    ld ix, (spr_asrc)
    ld a, (spr_cols)
    ld (spr_ccount), a
.cell:
    push hl
    ld b, 8
    xor a
.orl:
    or (hl)                     ; alguna linea de la mascara con tinta?
    ld c, a
    ld a, l
    add a, 32
    ld l, a
    ld a, c
    djnz .orl
    pop hl
    or a
    jr z, .skip
    ld a, (ix+0)
    ld (de), a
.skip:
    inc hl
    inc de
    inc ix
    ld a, (spr_ccount)
    dec a
    ld (spr_ccount), a
    jr nz, .cell
    ld hl, (spr_amask)
    inc h                       ; siguiente fila del buffer
    ld (spr_amask), hl
    ld de, 32
    ld hl, (spr_adst)
    add hl, de
    ld (spr_adst), hl
    ld hl, (spr_asrc)
    add hl, de
    ld (spr_asrc), hl
    pop bc
    djnz .row
    ret

spr_cols:       DEFB 0
spr_rows:       DEFB 0
spr_ccount:     DEFB 0
spr_dir:        DEFB 0
spr_delta:      DEFW 0
spr_asrc:       DEFW 0
spr_adst:       DEFW 0
spr_amask:      DEFW 0
spr_saved_x:    DEFW 0          ; x, y
spr_saved_cols: DEFB 0
spr_saved_rows: DEFB 0
spr_store:      DEFS SPR_STORE_CHARS * 9
ENDASM

LABEL sprSkip
]]
