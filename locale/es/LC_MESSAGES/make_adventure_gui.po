#: make_adventure_gui.py
msgid "Verbose output"
msgstr "Salida detallada"

#: make_adventure_gui.py
msgid "Slice texts between banks"
msgstr "Dividir textos entre bancos"

#: make_adventure_gui.py
msgid "Trim unused interpreter code"
msgstr "Quitar el código del intérprete que no se usa"

#: make_adventure_gui.py
msgid "Dead code elimination"
msgstr "Eliminar código inalcanzable"

#: make_adventure_gui.py
msgid "Show generated bytecode"
msgstr "Mostrar el bytecode generado"

#: make_adventure_gui.py
msgid "Allow statements without colons"
msgstr "Permitir instrucciones sin dos puntos"

#: make_adventure_gui.py
msgid "Use WYZ Tracker (instead of Vortex)"
msgstr "Usar WYZ Tracker (en lugar de Vortex)"

#: make_adventure_gui.py
msgid "Use 720 KB disk images (+3 only)"
msgstr "Usar imágenes de disco de 720 KB (solo +3)"

#: make_adventure_gui.py
