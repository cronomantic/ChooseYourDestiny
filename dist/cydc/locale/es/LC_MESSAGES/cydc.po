#: src/cydc/cydc/cydc_codegen.py
msgid "the jump at {at} goes into subroutine '{label}' instead of calling it with GOSUB"
msgstr "el salto de {at} entra en la subrutina '{label}' en vez de llamarla con GOSUB"

#: src/cydc/cydc/cydc_codegen.py
msgid "execution runs into subroutine '{label}' from the code above it (put a GOTO or END before it)"
msgstr "la ejecución entra en la subrutina '{label}' desde el código que tiene encima (pon un GOTO o un END antes)"

#: src/cydc/cydc/cydc_codegen.py
msgid "RETURN at {at} can run with no GOSUB pending"
msgstr "El RETURN de {at} puede ejecutarse sin ningún GOSUB pendiente"

#: src/cydc/cydc/cydc_codegen.py
